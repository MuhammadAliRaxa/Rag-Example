{
  "version": 2,
  "builds": [
    {
      "src": "src/api/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/api/main.py"
    }
  ],
  "env": {
    "VECTOR_DB_TYPE": "pinecone",
    "DEFAULT_MODEL": "gemini-2.5-flash",
    "ENV": "production",
    "DEBUG": "false"
  }
}
